# LiveKit Module
LIVEKIT_URL=ws://{YOUR_LIVEKIT_URL}:6880
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY  # e.g. devkey
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET # e.g. 8e8a70035172ba2c5b6058ca8b6c4e23832af89debc31edbd0f3ce8

# Python Project
WORKER_HOST=127.0.0.1
WORKER_PORT=4206

# STT Config
STT_WS_URL=wss://{YOUR_STT_KAGGLE_PUBLIC_URL}/stt/ws/stt

# TTS Config
TTS_WS_URL=wss://{YOUR_TTS_KAGGLE_PUBLIC_URL}/tts/ws/tts
TTS_SAMPLE_RATE=24000

# LLM Module
BASE_LLM_URL=YOUR_LLM_KAGGLE_PUBLIC_URL

CHAT_ENDPOINT=chat/v1/chat/completions
CHAT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

LLM_MAX_HISTORY_MESSAGES=20
HTTP_TIMEOUT_SECONDS=300
